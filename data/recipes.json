  {
    "name": "法式千層可麗餅蛋糕",
    "description": "參考「矽谷美味人妻」的食譜，據說是Lady M風味。",
    "servings": 8,
    "prepTime": 30,
    "cookTime": 60,
    "ingredients": [
      {
        "group": "餅皮麵糊",
        "items": [
          {
            "name": "無鹽奶油",
            "amount": 80,
            "unit": "g"
          },
          {
            "name": "牛奶",
            "amount": 3,
            "unit": "cup"
          },
          {
            "name": "蛋",
            "amount": 6,
            "unit": "個"
          },
          {
            "name": "麵粉",
            "amount": 1.5,
            "unit": "cup"
          },
          {
            "name": "糖",
            "amount": 7,
            "unit": "tbsp"
          },
            {
                "name": "鹽",
                "amount": 0.125,
                "unit": "tsp"
            }
        ]
      },
      {
        "group": "卡士達醬",
        "items": [
          {
            "name": "蛋",
            "amount": 1,
            "unit": "個"
          },
          {
            "name": "麵粉",
            "amount": 1,
            "unit": "tbsp"
          },
          {
            "name": "玉米粉",
            "amount": 1,
            "unit": "tbsp"
          },
          {
            "name": "砂糖",
            "amount": 2,
            "unit": "tbsp"
          },
          {
            "name": "香草精",
            "amount": 1,
            "unit": "tsp"
          },
            {
                "name": "牛奶",
                "amount": 1,
                "unit": "cup"
            }
        ]
      },
      {
        "group": "打發鮮奶油",
        "items": [
          {
            "name": "無糖動物性全脂鮮奶油",
            "amount": 2,
            "unit": "杯"
          },
          {
            "name": "糖",
            "amount": 1,
            "unit": "tbsp"
          }
        ]
      }
    ],
    "instructions": [
      {
        "group": "製作餅皮麵糊",
        "steps": [
          "加熱融化無鹽奶油，可以用低功率微波加熱20秒。小心不要微波太久，以免整塊奶油炸開。",
          "加入麵粉、加入麵粉、糖、鹽到融化奶油中，攪拌均勻。",
          "加入牛奶，繼續攪拌。有點顆粒也沒關係。",
          "冷藏至少4小時，最好隔夜。這樣沒有攪拌開的顆粒就會自己慢慢化開了。"
        ]
      },
      {
        "group": "煎餅皮",
        "steps": [
          "拿24cm的平底鍋，開中小火，倒入大約半湯勺的麵糊。用煎可麗餅專用的工具（或是鍋鏟）把麵糊攤平，形成薄薄的一層。",
          "拿另一個比較大28cm的平底鍋，也開中小火在旁邊預熱。",
          "不用煎到太乾太熟，表面有點濕潤就可以準備翻面了。",
          "因為有兩個鍋子，可以不用在同一個鍋子上翻面。直接把小的鍋子倒蓋到大的鍋子上，餅皮就翻過去了。",
          "翻在大鍋子的餅皮很難控制到完美的翻面，這也沒關係，先放著讓它加熱。",
          "翻面後立刻在小鍋子上倒上新一勺的麵糊，攤平新的麵糊後，就可以來處理剛剛翻到大鍋子的上一片餅皮了。",
          "儘量把翻過去的餅皮攤平，餅皮破掉也沒關係，充分加熱避免雞蛋沒熟比較重要。在裡面的餅皮最後組裝起來就看不出來了。",
          "差不多到小鍋子的餅皮要翻面時，就可以把大鍋飯過面的餅皮拿起來了。理想狀態是又薄又嫩的餅皮，太厚太熟口感會沒那麼好。",
          "第一片跟最後一片煎厚一點，最後組裝起來比較漂亮。"
        ]
      },
      {
        "group": "打發蛋白",
        "steps": [
          "蛋白打至硬性發泡",
          "分次加入馬斯卡彭混合物中輕輕攪拌"
        ]
      },
      {
        "group": "組裝",
        "steps": [
          "手指餅乾快速浸入咖啡浸液",
          "排列在模具底層",
          "鋪上一層馬斯卡彭奶醬",
          "重複前面步驟，最後以奶醬結尾"
        ]
      },
      {
        "group": "冷藏與完成",
        "steps": [
          "冷藏至少4小時",
          "上桌前撒上可可粉"
        ]
      }
    ],
    "tags": ["甜點"],
    "source": "https://kthu1031.pixnet.net/blog/posts/8168779730"
  },
  {
    "name": "台式甜不辣",
    "description": "自製魚漿製作的台灣傳統甜不辣，彈牙Q軟",
    "servings": 4,
    "prepTime": 30,
    "cookTime": 20,
    "ingredients": [
      {
        "group": "主要材料",
        "items": [
          {
            "name": "巴沙魚片(Pangasiusfilet)",
            "amount": 360,
            "unit": "g"
          },
          {
            "name": "馬鈴薯澱粉(Aardappelzetmeel)",
            "amount": 4,
            "unit": "tbsp"
          },
          {
            "name": "蛋白",
            "amount": 0.5,
            "unit": "個"
          },
          {
            "name": "冰塊",
            "amount": 2,
            "unit": "顆"
          }
        ]
      },
      {
        "group": "調味料",
        "items": [
          {
            "name": "鹽",
            "amount": 0.75,
            "unit": "tsp"
          },
          {
            "name": "糖",
            "amount": 2,
            "unit": "tsp"
          },
          {
            "name": "白胡椒粉",
            "amount": 0.5,
            "unit": "tsp"
          },
          {
            "name": "大蒜粉",
            "amount": 0.5,
            "unit": "tsp"
          },
          {
            "name": "泡打粉",
            "amount": 0.25,
            "unit": "tsp"
          }
        ]
      }
    ],
    "instructions": [
      {
        "group": "準備魚肉",
        "steps": [
          "巴沙魚片退冰後，用廚房紙巾將水分壓乾至有點乾澀的狀態",
          "切成小塊後，放入冷凍20分鐘"
        ]
      },
      {
        "group": "製作魚漿",
        "steps": [
          "將脫水的魚肉放入料理機中",
          "加入鹽，打至魚肉變黏稠",
          "加入蛋白、糖、白胡椒粉、大蒜粉和冰塊，打至均勻"
        ]
      },
      {
        "group": "加入澱粉",
        "steps": [
          "先加入60g馬鈴薯澱粉混合",
          "觀察質地，如果過稀再補入剩下10g澱粉",
          "混合至適當的黏稠度（像厚漿糊的質地）"
        ]
      },
      {
        "group": "成型與烹飪",
        "steps": [
          "裝入塑膠袋後，塑膠袋剪一個小洞，將魚漿擠出成條狀",
          "160°C熱油中炸到膨脹成型，撈起瀝油",
          "冷卻後可冷凍保存，食用前再炸一次加熱即可"
        ]
      }
    ],
    "tags": ["小吃"]
  },
  {
    "name": "口水雞",
    "description": "口感嫩滑的冷雞肉",
    "servings": 2,
    "prepTime": 10,
    "cookTime": 25,
    "ingredients": [
      {
        "name": "雞腿",
        "amount": 1,
        "unit": "kg"
      },
      {
        "name": "醬油",
        "amount": 2,
        "unit": "tbsp"
      },
      {
        "name": "醋",
        "amount": 1,
        "unit": "tbsp"
      },
      {
        "name": "花椒粉",
        "amount": 1,
        "unit": "g"
      },
      {
        "name": "薑",
        "amount": 1,
        "unit": "g"
      }
    ],
    "instructions": [
      "將雞腿洗淨，冷水蓋過雞腿，加蔥段薑片，水滾後，轉微小火煮 10-12 分鐘",
      "關火，蓋緊鍋蓋，燜20 分鐘",
      "準備一盆冷開水，加入大量冰塊。將燜好的帶骨雞腿直接投入，泡到雞腿徹底變涼",
      "冷卻後將雞腿去骨，放冰箱冷藏",
      "醬油、醋、花椒粉混合成醬底",
      "煮兩人份麵條，撈起後用冷水沖涼，瀝乾後放入碗中",
      "加入切好的雞肉，淋上醬底，可以加辣醬或是撒上蔥花和花生粉增加風味"
    ],
    "tags": [ "冷菜", "雞肉", "麻辣"],
    "source": "Gemini的食譜"
  },
  {
    "name": "巴伐利亞奶油蛋糕",
    "description": "底部是酥脆的餅乾碎，上方則是質地介於慕斯與果凍之間、口感紮實且絲滑的巴伐利亞奶油。",
    "servings": 6,
    "prepTime": 30,
    "cookTime": 60,
    "ingredients": [
      {
        "group": "餅乾底",
        "items": [
          {
            "name": "消化餅乾",
            "amount": 200,
            "unit": "g"
          },
          {
            "name": "無鹽奶油",
            "amount": 50,
            "unit": "g"
          }
        ]
      },
      {
        "group": "水果巴伐利亞層",
        "items": [
          {
            "name": "冷凍芒果塊",
            "amount": 250,
            "unit": "g"
          },
          {
            "name": "蛋黃",
            "amount": 3,
            "unit": "個"
          },
          {
            "name": "砂糖",
            "amount": 1,
            "unit": "tbsp"
          },
          {
            "name": "吉利丁片",
            "amount": 5,
            "unit": "片"
          },
          {
            "name": "鮮奶油(全脂35%)",
            "amount": 250,
            "unit": "ml"
          },
          {
            "name": "Dr. Oetker Klops-fix",
            "amount": 1,
            "unit": "包"
          },
          {
            "name": "新鮮草莓片(裝飾用)",
            "amount": 200,
            "unit": "g"
          }
        ]
      }
    ],
    "instructions": [
      {
        "group": "準備餅乾底",
        "steps": [
          "將餅乾放入袋中壓碎，或使用調理機打成粉狀。",
          "將奶油小功率微波融化後，與餅乾碎拌勻。",
          "平鋪在活動式蛋糕模具底部，用湯匙壓實，放入冰箱冷藏備用。",
        ]
      },
      {
        "group": "製作水果巴伐利亞層",
        "steps": [
          "吉利丁片泡入冷水5到10分鐘直至軟化。",
          "將冷凍芒果塊放入調理機打成泥狀，不用太碎，保留一些小顆粒增加口感。",
          "將蛋黃與砂糖攪拌至略微泛白。牛奶加熱至微滾後，慢慢倒入蛋黃液中（邊倒邊攪拌），再回爐上小火加熱，煮到濃稠狀（約 80°C，不要煮沸否則會變蛋花湯）。",
          "熄火，加入擠乾水分的吉利丁片攪拌至融化，接著倒入水果泥拌勻，靜置冷卻至常溫（不要冷到結塊）。",
          "鮮奶油加入Dr. Oetker Klops-fix，打發到有紋路但仍會流動的濃稠狀態。",
          "將冷卻的水果蛋黃液分兩次拌入打發的鮮奶油中，攪拌均勻。"
        ]
      },
      {
        "group": "組裝與冷藏",
        "steps": [
          "將拌好的巴伐利亞液倒入剛才準備好的餅乾底模具中。",
          "抹平表面，放入冰箱冷藏至少 4-6 小時（最好隔夜），直到完全凝固。",
          "冷藏至到稍微定型後，可以切草莓片擺在表面裝飾，增加色彩和風味。",
          "食用前將蛋糕從模具中取出，切片享用。"
        ]
      }
    ],
    "tags": ["甜點", "蛋糕"],
    "source": "Gemini的食譜"
  }
]
